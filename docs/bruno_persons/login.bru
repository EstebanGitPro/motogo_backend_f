meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "estebanpoly.e.a@yopmail.com",
    "password": "Secret123*"
  }
  
  
  
}

vars:pre-request {
  email: amordemadre@yopmail.com
}

script:post-response {
  if (res.status === 200 && res.body.data) {
    bru.setEnvVar("access_token", res.body.data.access_token);
    bru.setEnvVar("refresh_token", res.body.data.refresh_token);
    console.log("✅ Tokens guardados en environment exitosamente");
    console.log("Access token expira en: " + res.body.data.expires_in + " segundos");
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response has access_token", function() {
    expect(res.body.data.access_token).to.exist;
  });
  
  test("Response has refresh_token", function() {
    expect(res.body.data.refresh_token).to.exist;
  });
  
  test("Response has token_type", function() {
    expect(res.body.data.token_type).to.equal("Bearer");
  });
}

docs {
  # Login
  
  Autentica un usuario con email y contraseña, retornando tokens de acceso.
  
  ## Campos Requeridos
  - `email`: Correo electrónico del usuario
  - `password`: Contraseña del usuario
  
  ## Response
  - Status: 200 OK
  - `access_token`: Token de acceso JWT
  - `refresh_token`: Token para refrescar el acceso
  - `expires_in`: Tiempo de expiración del token (segundos)
  - `token_type`: Tipo de token (Bearer)
}
