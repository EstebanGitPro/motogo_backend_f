meta {
  name: 10 - Error Missing Latitude
  type: http
  seq: 10
}

get {
  url: {{base_url}}/branches/nearby?lng=-74.0721&radius=5
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Status code is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Response has error", function() {
    expect(res.body.success).to.be.false;
  });
  
  test("Error code is latitude required", function() {
    expect(res.body.message.code).to.equal("MOD_V_GEO_LAT_REQ_ERR_00001");
  });
}

docs {
  # Error: Missing Latitude
  
  Prueba de validación cuando no se envía latitud.
  
  ## Respuesta esperada
  - **400 Bad Request**
  - Código: `MOD_V_GEO_LAT_REQ_ERR_00001`
}
