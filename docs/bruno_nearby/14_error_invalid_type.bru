meta {
  name: 14 - Error Invalid Type
  type: http
  seq: 14
}

get {
  url: {{base_url}}/branches/nearby?lat=4.71&lng=-74.07&radius=5&type=INVALID_TYPE
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Status code is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Response has error", function() {
    expect(res.body.success).to.be.false;
  });
  
  test("Error code is invalid branch type", function() {
    expect(res.body.message.code).to.equal("MOD_B_INVALID_TYPE_ERR_00001");
  });
}

docs {
  # Error: Invalid Establishment Type
  
  Prueba de validación cuando se envía un tipo de establecimiento inválido.
  
  ## Tipos válidos
  - `WORKSHOP` - Taller
  - `STORE` - Tienda
  - `WORKSHOP_STORE` - Taller y Tienda
  
  ## Este test
  - Envía `type=INVALID_TYPE`
  
  ## Respuesta esperada
  - **400 Bad Request**
  - Código: `MOD_B_INVALID_TYPE_ERR_00001`
}
