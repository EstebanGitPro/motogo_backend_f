meta {
  name: Eliminar Excepción (HU22)
  type: http
  seq: 8
}

delete {
  url: {{base_url}}/schedule-exceptions/{{exception_id}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response has success message", function() {
    expect(res.body.message).to.exist;
  });
  
  test("Response has navigation links", function() {
    expect(res.body.data._links).to.exist;
  });
  
  test("Has list link for next action", function() {
    var listLink = res.body.data._links.find(l => l.rel === 'exceptions-list');
    expect(listLink).to.exist;
  });
}

docs {
  # Eliminar Excepción de Horario (HU22)
  
  Elimina permanentemente una excepción de horario.
  
  ## Response
  - Retorna enlaces HATEOAS para navegación post-eliminación
  
  ## Response Codes
  - **200**: Excepción eliminada
  - **403**: No autorizado
  - **404**: Excepción no encontrada
}
