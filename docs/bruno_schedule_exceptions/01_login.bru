meta {
  name: Login Representante
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "amordemadre@yopmail.com",
    "password": "Secret123*"
  }
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.access_token) {
    bru.setEnvVar("access_token", res.body.data.access_token);
    bru.setEnvVar("refresh_token", res.body.data.refresh_token);
    console.log("✅ Tokens guardados en environment exitosamente");
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response has access_token", function() {
    expect(res.body.data.access_token).to.exist;
  });
}

docs {
  # Login de Representante
  
  Inicia sesión para obtener el token de acceso necesario para los endpoints de excepciones de horario.
  
  ## Requisitos
  - Usuario con rol `REPRESENTANTE` registrado
  - Una sede con horario configurado
}
