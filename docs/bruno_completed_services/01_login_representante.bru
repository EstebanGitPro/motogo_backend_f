meta {
  name: Login Representante Sede
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "amordemadre@yopmail.com",
    "password": "Secret123*"
  }
}

script:post-response {
  if (res.status === 200) {
    var accessToken = res.body.data.access_token;
    bru.setVar("access_token", accessToken);
    console.log("✅ Token de representante guardado en access_token");
    console.log("🔑 Role:", res.body.data.role || "Verificar manualmente");
  } else {
    console.log("❌ Login fallido:", res.body);
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response has access_token", function() {
    expect(res.body.data.access_token).to.exist;
  });
}

docs {
  # Login Representante Sede
  
  Autenticación con usuario representante de sede para registrar y consultar servicios completados.
  
  ## Flujo
  1. Ejecutar este request para obtener el token
  2. El token se guarda automáticamente en `access_token`
  3. Usar el token en los siguientes requests
  
  ## Credenciales
  - **Email:** amordemadre@yopmail.com
  - **Password:** Secret123*
}
