meta {
  name: 06. Associate Services to Branch
  type: http
  seq: 6
}

post {
  url: {{base_url}}/branches/{{branch_id}}/services
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "service_ids": ["{{service_id}}"]
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has added_count", function() {
    expect(res.getBody().data.added_count).to.exist;
  });
}

docs {
  # Associate Services to Branch
  
  Asocia uno o más servicios del catálogo a una sede.
  
  ## Requiere autenticación (REPRESENTANTE)
  Ejecutar `00_login.bru` primero para obtener el token.
  
  ## Variables requeridas:
  - `branch_id`: ID de la sede (codificado)
  - `service_id`: ID del servicio a asociar (codificado)
  
  ## Endpoint:
  `POST /branches/:id/services`
  
  ## Body:
  ```json
  {
    "service_ids": ["service_id_1", "service_id_2"]
  }
  ```
  
  ## Respuesta:
  ```json
  {
    "data": {
      "added_count": 2,
      "_links": [
        {"rel": "branch_services", "href": "/branches/xyz/services", "method": "GET"}
      ]
    }
  }
  ```
}
