meta {
  name: Login Representante
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "amordemadre@yopmail.com",
    "password": "Secret123*"
  }
}

script:post-response {
  if (res.status === 200) {
    var accessToken = res.body.data.access_token;
    bru.setVar("access_token", accessToken);
    console.log("✅ Token de representante guardado en access_token");
  } else {
    console.log("❌ Login fallido:", res.body);
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response has access_token", function() {
    expect(res.body.data.access_token).to.exist;
  });
}

docs {
  # Login Representante
  
  Autenticación con usuario representante para obtener el token.
  El token se guarda automáticamente en `access_token`.
}
