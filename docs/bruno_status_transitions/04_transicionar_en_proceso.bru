meta {
  name: Transicionar a EN_PROCESO (HU74)
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/completed-services/{{completed_service_id}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "status": "EN_PROCESO"
  }
}

script:post-response {
  if (res.status === 200) {
    console.log("✅ Estado actualizado a EN_PROCESO");
    console.log("📋 Código:", res.body.code);
    console.log("💬 Mensaje:", res.body.message);
  } else {
    console.log("❌ Error:", res.status, res.body);
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response has success true", function() {
    expect(res.body.success).to.be.true;
  });
}

docs {
  # PATCH /completed-services/:id/status (HU74)
  
  Transiciona el estado de **PENDIENTE → EN_PROCESO** ✅
  
  ## Transición
  - **Desde:** PENDIENTE
  - **Hacia:** EN_PROCESO
  - **Esperado:** 200 OK
}
