meta {
  name: 07_add_branch_to_franchise
  type: http
  seq: 7
}

post {
  url: {{base_url}}/franchises/{{franchise_id}}/branches
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "branch_id": "{{branch_id}}"
  }
}

vars:post-response {
  response_code: res.body.code
}

tests {
  test("Response status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response has success code", function() {
    expect(res.body.code).to.include("MOD_F_BRANCH_ADD");
  });
  
  test("Response has HATEOAS links", function() {
    expect(res.body.data).to.have.property("_links");
  });
}

docs {
  # Agregar Sede a Franquicia
  
  Este endpoint vincula una sede existente a una franquicia.
  
  ## Prerequisitos
  - Token de acceso válido (ejecutar login primero)
  - ID de franquicia válido en variable `franchise_id`
  - ID de sede válido en variable `branch_id`
  
  ## Request Body
  ```json
  {
    "branch_id": "encoded_branch_id"
  }
  ```
  
  ## Respuestas
  - **200**: Sede agregada exitosamente
  - **400**: JSON inválido
  - **403**: Sede no pertenece al representante
  - **404**: Franquicia o sede no encontrada
}
