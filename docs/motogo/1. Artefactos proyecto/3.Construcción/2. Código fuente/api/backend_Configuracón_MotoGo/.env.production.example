# ============================================
# PRODUCCIÓN - Variables de entorno
# ============================================
# INSTRUCCIONES:
# 1. Copiar: cp .env.production.example .env.production
# 2. Generar passwords seguros: openssl rand -base64 24
# 3. Reemplazar TODOS los valores "CAMBIAR_..."
# 4. NUNCA subir este archivo a Git
# ============================================

# --- MySQL App ---
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# --- MySQL Keycloak ---
MYSQL_KC_ROOT_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_KC

# --- Keycloak ---
KEYCLOAK_ADMIN=motogo-admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_POR_ADMIN_PASSWORD_SEGURO
KC_HOSTNAME=auth.tudominio.com
KEYCLOAK_CLIENT_SECRET=CAMBIAR_POR_CLIENT_SECRET

# --- Resend (Email) ---
RESEND_API_KEY=CAMBIAR_POR_TU_RESEND_API_KEY
