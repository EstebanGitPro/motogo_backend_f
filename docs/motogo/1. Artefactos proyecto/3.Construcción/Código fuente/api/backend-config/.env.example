# ============================================
# MotoGo Backend - Variables de Entorno
# ============================================
# Copiar este archivo como .env y llenar los valores.
# .env está ignorado por Git (secrets seguros).
# ============================================

# ── Entorno ──────────────────────────────────
APP_ENV=local

# ── Base de Datos ────────────────────────────
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3309
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=motogoDb
DB_SSL=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300
DB_CONN_MAX_IDLE_TIME=60

# ── Servidor ─────────────────────────────────
SERVER_PORT=8085
SERVER_HOST=0.0.0.0

# ── Resend (Email) ───────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=motogo@rbsuport.com

# ── Keycloak ─────────────────────────────────
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=motogo
KEYCLOAK_CLIENT_ID=stifler
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# ── Verificación ─────────────────────────────
VERIFICATION_BASE_URL=http://localhost:8085

# ── ID Encoder ───────────────────────────────
ID_ENCODER_SECRET=
ID_ENCODER_MIN_LENGTH=36

# ── Firebase ─────────────────────────────────
FIREBASE_CREDENTIALS_PATH=config/serviceAccountKey.json

# ── Geocoding ────────────────────────────────
GEOCODING_PROVIDER=google
GEOCODING_API_KEY=
GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode
GEOCODING_TIMEOUT=5
GEOCODING_COUNTRY_CODE=co
GEOCODING_FALLBACK_PROVIDER=mapbox
GEOCODING_FALLBACK_API_KEY=
GEOCODING_FALLBACK_BASE_URL=https://api.mapbox.com/search/geocode/v6
