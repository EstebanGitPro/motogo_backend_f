meta {
  name: Register Branch with User Coords
  type: http
  seq: 5
}

post {
  url: {{base_url}}/branches
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Taller GPS Preciso",
    "establishment_type": "STORE",
    "location": {
      "department_id": "a1b2c3d4-1111-4000-8000-000000000001",
      "city_id": "b2c3d4e5-2222-4000-8000-000000000001",
      "address": "Transversal 45 #100-50, Usaquén",
      "latitude": 4.7110,
      "longitude": -74.0721
    }
  }
}

tests {
  test("Status code is 201 Created", function() {
    expect(res.status).to.equal(201);
  });
  
  test("Geocoding status is SKIPPED", function() {
    expect(res.body.data.geocoding_status).to.equal("SKIPPED");
  });
}

docs {
  # Register Branch with User Coords
  
  Cuando el usuario envía `latitude` y `longitude`, el backend NO hace geocoding.
  
  ## Behavior
  - Si lat/lng presentes: `geocoding_status = SKIPPED`
  - El backend usa las coordenadas enviadas por el usuario
  
  ## Uso Típico
  El frontend puede obtener las coordenadas del dispositivo del usuario
  y enviarlas directamente, evitando llamadas a la API de geocoding.
}
