meta {
  name: Get Branch (HU62) - Not Found
  type: http
  seq: 21
}

get {
  url: {{base_url}}/branches/nonexistent12345
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Status code is 400 or 404", function() {
    expect([400, 404]).to.include(res.status);
  });
  
  test("Response has success false", function() {
    expect(res.body.success).to.be.false;
  });
  
  test("Response has error code", function() {
    expect(res.body.code).to.exist;
  });
}

docs {
  # Get Branch (HU62) - Not Found Error
  
  Verifica el manejo de error cuando se consulta una sede inexistente.
  
  ## Prerrequisitos
  1. **Ejecutar Login primero** (01_login.bru)
  
  ## Escenario
  Se intenta consultar una sede con un ID que no existe en el sistema.
  
  ## Respuestas Esperadas
  - **400**: ID inválido (formato incorrecto)
  - **404**: Sede no encontrada
}
