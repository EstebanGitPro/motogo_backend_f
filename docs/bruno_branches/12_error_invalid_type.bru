meta {
  name: ERROR - Invalid Establishment Type
  type: http
  seq: 12
}

post {
  url: {{base_url}}/branches
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Taller Tipo Inválido",
    "establishment_type": "GARAGE",
    "location": {
      "department_id": "a1b2c3d4-1111-4000-8000-000000000001",
      "city_id": "b2c3d4e5-2222-4000-8000-000000000001",
      "address": "Carrera 10 #50-60"
    }
  }
}

tests {
  test("Status code is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Response has error about type", function() {
    expect(res.body.success).to.be.false;
  });
}

docs {
  # Error Case: Invalid Establishment Type
  
  Prueba que el servidor rechaza tipos de establecimiento inválidos.
  
  ## Tipos Válidos
  - `WORKSHOP`
  - `STORE`
  
  ## Tipo Enviado
  - `GARAGE` (inválido)
  
  ## Comportamiento Esperado
  - **Status**: 400 Bad Request
}
