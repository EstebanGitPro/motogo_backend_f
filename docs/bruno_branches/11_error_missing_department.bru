meta {
  name: ERROR - Missing Department ID
  type: http
  seq: 11
}

post {
  url: {{base_url}}/branches
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Taller Sin Departamento",
    "establishment_type": "WORKSHOP",
    "location": {
      "city_id": "b2c3d4e5-2222-4000-8000-000000000001",
      "address": "Calle 80 #15-30"
    },
    "brands": ["f6a7b8c9-6666-4000-8000-000000000001"]
  }
}

tests {
  test("Status code is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Response has error", function() {
    expect(res.body.success).to.be.false;
  });
}

docs {
  # Error Case: Missing Department ID
  
  Prueba que el servidor rechaza una solicitud sin `department_id` en location.
  
  ## Comportamiento Esperado
  - **Status**: 400 Bad Request
  - **Error**: Campo `location.department_id` es requerido
}
