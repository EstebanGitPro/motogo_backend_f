meta {
  name: Get Brand Lines - Forbidden (HU40)
  type: http
  seq: 2
}

get {
  url: {{base_url}}/admin/brands/{{brand_id}}/lines
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

script:pre-request {
  console.log("Testing admin endpoint with non-admin user...");
  console.log("Expected: 401 or 403 Forbidden");
}

tests {
  test("Status code is 401 or 403", function() {
    expect([401, 403]).to.include(res.getStatus());
  });
  
  test("Response indicates access denied", function() {
    expect(res.getBody().success).to.be.false;
  });
}

docs {
  # Get Brand Lines - Forbidden Test (HU40)
  
  Prueba que el endpoint rechaza usuarios sin rol ADMIN.
  
  ## Prerrequisitos:
  1. Hacer login con un usuario que NO tenga rol ADMIN (ej: MOTOCICLISTA o REPRESENTANTE)
  2. Intentar acceder al endpoint admin
  
  ## Resultado esperado:
  - **401 Unauthorized**: Cuando el token no es válido para admin
  - **403 Forbidden**: Cuando el usuario no tiene rol ADMIN
  
  ## Propósito:
  Verificar que el middleware `RequireRole(domain.RoleAdmin)` funciona correctamente
  y protege el endpoint de accesos no autorizados.
}
