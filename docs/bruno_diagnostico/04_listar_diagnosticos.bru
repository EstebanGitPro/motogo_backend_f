meta {
  name: Listar Diagnósticos (HU14)
  type: http
  seq: 5
}

get {
  url: {{base_url}}/motorcycles/{{motorcycle_id}}/diagnostics
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length > 0) {
    var diagnosticId = res.body.data[0].id;
    bru.setVar("diagnostic_id", diagnosticId);
    console.log("✅ Diagnósticos encontrados:", res.body.data.length);
    console.log("🔧 diagnostic_id guardado:", diagnosticId);
  } else if (res.status === 200) {
    console.log("ℹ️ No hay diagnósticos para esta moto.");
  } else {
    console.log("❌ Error:", res.body);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response has success", function() {
    expect(res.body.success).to.be.true;
  });
  
  test("Response data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
  
  test("Each diagnostic has required fields", function() {
    if (res.body.data.length > 0) {
      var d = res.body.data[0];
      expect(d.id).to.exist;
      expect(d.motorcycle_id).to.exist;
      expect(d.branch_id).to.exist;
      expect(d.date).to.exist;
    }
  });
}

docs {
  # GET /motorcycles/:id/diagnostics - Listar Diagnósticos (HU14)
  
  Lista todos los diagnósticos de una motocicleta. Solo el propietario puede listar.
  
  ## Prerrequisitos
  1. Ejecutar Login (01_login_usuario.bru)
  2. Ejecutar Listar Motos (02_listar_motos.bru) → motorcycle_id
  
  ## Respuestas
  - **200**: Array de diagnósticos con evidencias
  - **401**: Token inválido
  - **404**: Moto no encontrada o no es propietario
}
