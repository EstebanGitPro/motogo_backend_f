meta {
  name: Lookup Motorcycle by Plate (HU47) - Missing Param
  type: http
  seq: 14
}

get {
  url: {{base_url}}/motorcycles/lookup
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("Status code is 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Response has success false", function() {
    expect(res.body.success).to.be.false;
  });
  
  test("Response has error message", function() {
    expect(res.body.message).to.exist;
  });
}

docs {
  # Lookup Motorcycle by Plate (HU47) - Missing Parameter
  
  Caso de error cuando no se envía el parámetro `plate`.
  
  ## Prerrequisitos
  1. **Ejecutar Login como REPRESENTANTE**
  
  ## Respuesta Esperada
  - Código: 400 Bad Request
  - `success`: false
  - `message`: Mensaje indicando que falta el parámetro plate
}
