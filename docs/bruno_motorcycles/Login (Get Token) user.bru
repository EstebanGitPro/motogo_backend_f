meta {
  name: Login (Get Token) user
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "negro@yopmail.com",
    "password": "Secret123*"
  }
}

script:post-response {
  if (res.status === 200) {
    var accessToken = res.body.data.access_token;
    bru.setVar("access_token", accessToken);
    console.log("✅ Token saved to access_token variable");
  } else {
    console.log("❌ Login failed:", res.body);
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response has access_token", function() {
    expect(res.body.data.access_token).to.exist;
  });
}

docs {
  # Login
  
  Autenticación para obtener token de acceso.
  
  ## Notas
  - El token se guarda automáticamente en la variable `access_token`
  - Usar un usuario con motorcycles registradas para probar HU46
}
