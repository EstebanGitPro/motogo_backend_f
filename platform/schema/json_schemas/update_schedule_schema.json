{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Update Schedule",
  "description": "Schema for updating a branch schedule (HU31)",
  "type": "object",
  "properties": {
    "active": {
      "type": "boolean",
      "description": "Whether the schedule is active — BOOLEAN"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Schedule start date YYYY-MM-DD — DATE"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Schedule end date YYYY-MM-DD (null=indefinite) — DATE"
    }
  },
  "minProperties": 1,
  "additionalProperties": false
}
