{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Update Schedule Exception Schema",
  "description": "Validates schedule exception update for HU21",
  "type": "object",
  "properties": {
    "opening_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$",
      "description": "HH:MM format (24h)"
    },
    "closing_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$",
      "description": "HH:MM format (24h)"
    },
    "is_closed": {
      "type": "boolean",
      "description": "If true, the branch is closed for this date"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "is_closed": { "const": false } },
        "required": ["is_closed"]
      },
      "then": {
        "required": ["opening_time", "closing_time"]
      }
    }
  ]
}
