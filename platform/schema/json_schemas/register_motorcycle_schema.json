{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Register Motorcycle Schema",
  "description": "Schema for motorcycle registration (HU43)",
  "type": "object",
  "required": ["license_plate", "reference_id"],
  "properties": {
    "license_plate": {
      "type": "string",
      "description": "Colombian motorcycle/car license plate. Formats: MRC35E (moto) or XYZ 123 (carro)",
      "pattern": "^[A-Z0-9]{3,4} ?[A-Z0-9]{2,3}$",
      "minLength": 5,
      "maxLength": 10
    },
    "reference_id": {
      "type": "string",
      "description": "Encoded hashid of the motorcycle reference from catalog",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "description": "Year of manufacture",
      "minimum": 1900,
      "maximum": 2100
    },
    "current_mileage": {
      "type": "integer",
      "description": "Current mileage in kilometers",
      "minimum": 0,
      "maximum": 9999999
    },
    "owner_notes": {
      "type": "string",
      "description": "Optional notes from the owner about the motorcycle",
      "maxLength": 500
    },
    "profile_image_url": {
      "type": "string",
      "description": "HU36 - Optional Firebase Storage URL for motorcycle profile image",
      "maxLength": 500
    }
  },
  "additionalProperties": false
}
