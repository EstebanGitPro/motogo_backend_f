{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schedule Exception Schema",
  "description": "Validates schedule exception creation for HU20-25",
  "type": "object",
  "required": ["exception_start_date"],
  "properties": {
    "exception_start_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Start date for exception range (YYYY-MM-DD)"
    },
    "exception_end_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "End date for exception range (YYYY-MM-DD). Defaults to start date if omitted."
    },
    "opening_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$",
      "description": "HH:MM format (24h)"
    },
    "closing_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$",
      "description": "HH:MM format (24h)"
    },
    "is_closed": {
      "type": "boolean",
      "description": "If true, the branch is closed for this date range"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "is_closed": { "const": false } },
        "required": ["is_closed"]
      },
      "then": {
        "required": ["opening_time", "closing_time"]
      }
    }
  ]
}
