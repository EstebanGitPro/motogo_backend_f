{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rate Service Item",
  "description": "Schema for rating a completed service item (RELEASE_14 / HU48)",
  "type": "object",
  "properties": {
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating value (1-5 stars)"
    },
    "comment": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional comment about the service"
    }
  },
  "required": ["rating"],
  "additionalProperties": false
}
