{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Create Diagnostic",
  "description": "Schema for creating a motorcycle diagnostic request (HU11)",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "minLength": 1,
      "description": "Obfuscated branch ID (hashid)"
    },
    "problem_description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Problem description by user — TEXT"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "maxLength": 255,
        "pattern": "^https://firebasestorage\\.googleapis\\.com/.*$"
      },
      "description": "Firebase Storage URLs for diagnostic evidence photos — VARCHAR(255)"
    }
  },
  "required": ["branch_id"],
  "additionalProperties": false
}
