# ============================================
# .dockerignore — MotoGo Backend
# ============================================
# Reduce el build context para builds más rápidos

# Binarios
bin/
*.exe
*.dll
*.so
*.dylib

# Archivos de prueba
*_test.go
*.test
mocks/
tests/

# Dependencias
vendor/

# IDEs
.vscode/
.idea/
.gemini/
.agents/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Documentación (no necesaria para build)
docs/
documents_motogo/
README.md
CONTRIBUTING.md
SECURITY.md
CHANGELOG.md
LICENSE

# Configuración local (no enviar a la imagen)
config/local-config.json
config/serviceAccountKey.json

# Logs
*.log

# Temporal
tmp/
temp/

# Observabilidad (servicios separados, no van en la API)
platform/grafana/
platform/promtail/
platform/loki/
platform/log-rotator/
platform/k6/

# Deploy scripts (concern separado)
deploy/
scripts/

# Keycloak (container separado)
Containerfile
tools/keycloak-themes/

# Docker compose files
docker-compose*.yml
